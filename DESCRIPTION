Package: SelfControlledCohort
Type: Package
Title: Self-Controlled Cohort Population-Level Estimation
Version: 2.0.0
Date: 2026-05-27
Authors@R: c(
    person("Jamie", "Gilbert", email = "gilbert@ohdsi.org", role = c("cre", "aut"), comment = c(ORCID = "0000-0003-2294-3459")),
